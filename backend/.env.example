# Server
PORT=5000

# MySQL — local server runs on 3308, not the default 3306
DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=weatherwise

# Google Gemini — free key from https://aistudio.google.com
# Leave GEMINI_API_KEY unset to run without AI insights (everything else works).
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the model if the default is ever deprecated.
GEMINI_MODEL=gemini-3.5-flash
